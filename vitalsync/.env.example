# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Nom de la base de données créée au démarrage du conteneur PostgreSQL
POSTGRES_DB=your_database_name

# Utilisateur PostgreSQL avec droits sur POSTGRES_DB
POSTGRES_USER=your_db_user

# Mot de passe de l'utilisateur PostgreSQL (ne jamais commiter la valeur réelle)
POSTGRES_PASSWORD=your_secure_password

# ── Backend Node.js ─────────────────────────────────────────────────────────────
# Environnement d'exécution : "development" ou "production"
NODE_ENV=production

# Port exposé par le backend sur l'hôte (mappé vers 3000 dans le conteneur)
PORT=3000
